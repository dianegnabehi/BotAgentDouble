# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Groq AI API (Gratuit sur https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b

# Enrichissement B2B Hunter.io (Optionnel - 25 recherches gratuites/mois sur https://hunter.io/api)
# Combiné automatiquement avec la recherche Web LinkedIn + Scraping du site + DNS MX
HUNTER_API_KEY=your-hunter-api-key

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
TELEGRAM_ADMIN_CHAT_ID=123456789

# Configuration GCP Compute Engine (e2-micro) + HTTPS Caddy
N8N_DOMAIN=35-xxx-xxx-xxx.nip.io
N8N_ENCRYPTION_KEY=change_me_with_random_hex_string
