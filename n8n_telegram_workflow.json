      "id": "2a4f0000-0001-4000-8000-000000000002",
      "name": "Supabase - Lire Entreprises A Enrichir",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        460,
        -240
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase Account"
        }
      }
