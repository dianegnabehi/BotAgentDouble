      "parameters": {
        "jsCode": "const now = Date.now();\nconst SEPT_JOURS_MS = 7 * 24 * 60 * 60 * 1000;\nconst results = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  if (!['Envoyé', 'Relancé'].includes(row.statut)) continue;\n\n  const refDateStr = row.date_derniere_relance || row.date_envoi;\n  if (!refDateStr) continue;\n\n  const refTime = new Date(refDateStr).getTime();\n  const elapsedMs = now - refTime;\n\n  if (elapsedMs >= SEPT_JOURS_MS) {\n    const nbRelances = Number(row.nb_relances || 0);\n    results.push({\n      json: {\n        ...row,\n        nb_relances: nbRelances,\n        prochain_num_relance: nbRelances + 1,\n        action_j7: nbRelances < 2 ? 'relancer' : 'cloturer_refus'\n      }\n    });\n  }\n}\n\nreturn results;"
      },
