    {
      "parameters": {
        "jsCode": "function normalizeAscii(str) {\n  return (str || '')\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .toLowerCase()\n    .replace(/[^a-z0-9.-]/g, '');\n}\n\nconst groqItems = $input.all();\nconst sourceItems = $('Code - Collecter Web + Hunter + DNS MX').all();\nconst validOutputs = [];\n\nfor (let i = 0; i < groqItems.length; i++) {\n  const rawText = (groqItems[i].json.choices?.[0]?.message?.content || '{}')\n    .replace(/<think>[\\s\\S]*?<\\/think>/g, '')\n    .replace(/```json|```/g, '')\n    .trim();\n  const src = sourceItems[i]?.json || {};\n  const domain = src.domain || '';\n\n  let parsed = {};\n  try {\n    const match = rawText.match(/\\{[\\s\\S]*\\}/);\n    parsed = JSON.parse(match ? match[0] : rawText);\n  } catch (e) {\n    parsed = {};\n  }\n\n  let nom = (parsed.nom_contact || '').trim();\n  let poste = (parsed.poste_contact || src.poste_contact || 'CTO / Responsable Tech').trim();\n  let email = (parsed.email_contact || '').trim().toLowerCase();\n\n  // Fallback 1 : Si Hunter.io a remonte un contact verifie\n  if ((!email || !nom) && Array.isArray(src.hunter_contacts) && src.hunter_contacts.length > 0) {\n    const bestHunter = src.hunter_contacts[0];\n    if (!nom && bestHunter.nom) nom = bestHunter.nom;\n    if (bestHunter.poste) poste = bestHunter.poste;\n    if (!email && bestHunter.email) email = bestHunter.email.toLowerCase();\n  }\n\n  // Fallback 2 : Si un vrai Prenom Nom est identifie et que le domaine a un MX actif, construire prenom.nom@domaine\n  const isRealPersonName = nom && nom.split(/\\s+/).length >= 2 && !/equipe|équipe|inconnu|non renseign|contact|recrutement|n\\/a/i.test(nom);\n  if (!email && isRealPersonName && domain && src.has_mx) {\n    const parts = nom.trim().split(/\\s+/);\n    const first = normalizeAscii(parts[0]);\n    const last = normalizeAscii(parts.slice(1).join(''));\n    if (first && last) {\n      email = `${first}.${last}@${domain}`;\n    }\n  }\n\n  // Fallback 3 : Email officiel trouve directement sur le site de l'entreprise\n  if (!email && Array.isArray(src.site_emails) && src.site_emails.length > 0) {\n    email = src.site_emails[0].toLowerCase();\n    if (!nom) nom = `Équipe Tech & Recrutement ${src.entreprise || ''}`.trim();\n  }\n\n  // Nettoyage des accents eventuels dans l'adresse email\n  if (email && email.includes('@')) {\n    const [localPart, domPart] = email.split('@');\n    email = `${normalizeAscii(localPart)}@${normalizeAscii(domPart)}`;\n  }\n\n  const isValidEmail =\n    /^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/i.test(email) &&\n    !email.endsWith('@domaine.com') &&\n    !email.endsWith('@exemple.com') &&\n    !email.endsWith('@entreprise.com') &&\n    !email.startsWith('prenom.nom@');\n\n  // Filtre strict : on ne sauvegarde que si on a un nom et un email valide\n  if (!isValidEmail || !nom) {\n    continue;\n  }\n\n  validOutputs.push({\n    json: {\n      id: src.id,\n      nom_contact: nom,\n      poste_contact: poste,\n      email_contact: email\n    }\n  });\n}\n\nreturn validOutputs;"
      },
